# Copy to .env and fill in locally.
# Full HTTPS URL for your provider's Chat Completions endpoint.
LLM_ENDPOINT=
LLM_MODEL=
LLM_API_KEY=

# Default: ../part1_handoff (relative to this repository, not the current shell).
PART1_HANDOFF_PATH=
# Default: programmes.json. Maintainer-provided name/alias -> internal ID mapping.
# Users state their programme name; no global programme ID is assumed.
PROGRAMME_MAP_PATH=
# Optional: first teaching-week start, YYYY-MM-DD. Missing -> return all weeks.
SEMESTER_START=
