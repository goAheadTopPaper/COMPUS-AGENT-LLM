# Copy to .env and fill in locally.
# Full HTTPS URL for your provider's Chat Completions endpoint.
# LLM访问url
LLM_ENDPOINT=
# LLM模型
LLM_MODEL=
# LLM Key
LLM_API_KEY=

# Default: ../part1_handoff (relative to this repository, not the current shell).规章资料、检索索引所在目录
PART1_HANDOFF_PATH='./part1_handoff'
# Default: programmes.json. Maintainer-provided name/alias -> internal ID mapping.
# 项目名称与内部 programmeId 的映射文件
PROGRAMME_MAP_PATH='./programmes.discovered.json'
# 不用填
SEMESTER_START=
